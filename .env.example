# Modo de base de datos:
# - cloud  -> solo Supabase (app web en la nube)
# - dual   -> SQL Server local + sincroniza con Supabase (app de tienda)
# - local  -> solo SQL Server (contingencia sin nube)
DATABASE_MODE=local

# Supabase (PostgreSQL) — usado por la app web y como respaldo en modo dual
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# SQL Server local (LexyLocal en SSMS)
MSSQL_SERVER=127.0.0.1
MSSQL_DATABASE=LexyLocal
# Sin MSSQL_PORT: auto-detecta el puerto dinamico de SQLEXPRESS desde el registro
# MSSQL_PORT=56566
MSSQL_TRUSTED_CONNECTION=true
# Si no usas Windows Auth, comenta MSSQL_TRUSTED_CONNECTION y define usuario:
# MSSQL_USER=sa
# MSSQL_PASSWORD=your-password

LEXY_JWT_SECRET=change-me-to-a-long-random-secret
PORT=3001

# Modo tienda (npm run store)
# HOST=127.0.0.1
# SERVE_STATIC=1
